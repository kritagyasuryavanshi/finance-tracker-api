# Postgres connection string (any SQLAlchemy URL works, e.g. sqlite:///./local.db for quick local runs)
DATABASE_URL=postgresql://user:password@localhost:5432/finance

# Long random string used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Google AI Studio key (either name works)
GEMINI_API_KEY=

# Optional
# ALLOWED_ORIGINS=https://your-frontend.vercel.app   # comma-separated; default "*"
# CURRENCY_SYMBOL=₹                                    # used in AI prompts and reports
# DATA_DIR=./chroma_db                                 # per-user vector stores
